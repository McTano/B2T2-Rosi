--------------------------------------------------------------------------------
-- List utils
--------------------------------------------------------------------------------

zip : List a -> List b -> List (Pair a b)
zip = fix (\zip.
              ( 'Nil: u -> const nil
              | 'Cons: xs -> 
                    (  'Nil: u -> nil
                    | 'Cons: ys -> cons (pair xs.'1 ys.'1) (zip xs.'2 ys.'2))))

unzip : List (Pair a b) -> Pair (List a) (List b)
unzip = foldr (\p xs_ys. (pair (cons p.'1 xs_ys.'1) (cons p.'2 xs_ys.'2))) (pair nil nil)

-- equivalent to zip with a stream that repeats the first argument
zipRepeat : a -> List b -> List (Pair a b)
zipRepeat = \a. map (\b. pair a b)

enumerateHelper : Nat -> List a -> List (Pair a Nat)
enumerateHelper = fix (\enumerateHelper n.
                                    ( 'Nil: u -> nil
                                    | 'Cons: xs -> cons (pair (xs.'1) n) (enumerateHelper (succ n) xs.'2)))

enumerate : List a -> List (Pair a Nat)
enumerate = enumerateHelper 0

find : (a -> Bool) -> List a -> Maybe a
find = fix (\find f.
                    ( 'Nil: u -> Nothing
                    | 'Cons: xs -> (if (f xs.'1)
                                      (Just xs.'1)
                                      (find f xs.'2))))

findAll : (a -> Bool) -> List a -> List a
findAll = fix (\findAll f.
                    ( 'Nil: u -> nil
                    | 'Cons: xs -> (if (f xs.'1)
                                       (cons xs.'1 (findAll f xs.'2))
                                       (findAll f xs.'2))))

findIndex : (a -> Bool) -> List a -> Maybe Nat
findIndex = \f xs. maybe Nothing (\x. Just (x.'2)) (find (\p. f p.'1) (enumerate xs))

filter : (a -> Bool) -> List a -> List a
filter = \f ls. foldr (\e a. if (f e)
                                (cons e a)
                                        a) nil ls

filterMaybe : List (Maybe a) -> List a
filterMaybe = foldr (\e a. ( 'Just: x -> (cons x a)
                           | 'Nothing: u -> a) e) nil 

length : List a -> Nat
length = foldr (\e a. succ a) 0

takeN : List a -> Nat -> List a
takeN = fix (\takeN xs. ( 'Zero: u -> nil
                       | 'Succ: pr -> ( 'Nil: u -> nil
                                     | 'Cons: ys -> cons ys.'1 (takeN ys.'2 pr)) xs))

all : (a -> Bool) -> List a -> Bool
all = \f xs. foldr and True (map f xs) 

-- placeholder for sort function
sort : Compare a -> List a ->  List a
sort = \ls cmp. sorry


--------------------------------------------------------------------------------
-- Partitions as Records
--------------------------------------------------------------------------------
-- NOTE: I switched to using a Dict for partitions in most cases.
--       I'm unsure whether there are cases where this is actually better.

type Partition : * -> R[*] -> *
type Partition = \t ks. Pi ((Const (List t))* ks)

-- returns a record in which each label in ks is mapped to an empty list
emptyPartition : forall t:*. Partition t ks
emptyPartition = \@t. syn #(Const (List t)) (\l. nil)

extendPartition : Partition t ks -> Sigma (Labels ks) -> t -> Partition t ks
extendPartition = \p k t. ana #(Const Unit) (\l. const ((l := cons t p.l) ++ (prj p))) k

-- helpers for groupBy
partition : (Pi r -> (Sigma (Labels ks))) -> List (Pi r) -> Partition (Pi r) ks
partition = \key t. foldr (\r a. extendPartition a (key r) r) emptyPartition t

projectPartition : forall v:*. Partition t ks -> (t -> v) -> Partition v ks
projectPartition = \@v. \p project. syn #(Const (List v)) (\l. map project p.l)

aggregatePartition : forall v rt:*. Partition v ks -> (Sigma (Labels ks) -> List v -> rt) -> Pi ((Const rt) ks)
aggregatePartition = \@v @rt. \p aggregate. syn #(Const rt) (\k. aggregate (inj (k := tt)) p.k)

--------------------------------------------------------------------------------
-- Dict
--------------------------------------------------------------------------------

type Dict : * -> * -> *
type Dict = \k v . List (Pair k v)

emptyDict : Dict k v
emptyDict = nil

getD : Dict k v -> Eq k -> k -> Maybe v
getD = fix (\getD d eq k.
                  (  'Nil: u -> Nothing
                  |  'Cons: ys -> if (eq ys.'1.'1 k)
                                       (Just ys.'1.'2)
                                       (getD ys.'2 eq k)
                  ) d)

setD : Dict k v -> Eq k -> k -> v -> Dict k v
setD = fix (\setD d eq k v.
                  (  'Nil: u -> (cons (pair k v) nil)
                  |  'Cons: ys -> if (eq ys.'1.'1 k)
                                      (cons (pair k v) ys.'2)
                                      (cons ys.'1 (setD ys.'2 eq k v))
                  ) d)

inc : Dict k Nat -> Eq k -> k -> Dict k Nat
inc = \d eq k. setD d eq k (maybe 1 succ (getD d eq k))

-- Dict partitions:
addToPartition : Dict K (List V) -> Eq K -> K -> V -> Dict K (List V)
addToPartition = \d eq k v.
  let curr = fromMaybe nil (getD d eq k) in
    setD d eq k (cons v curr)

partitionWithDict : (TableRow r -> K) -> (Eq K) -> Table r -> Dict K (Table r)
partitionWithDict = \key eq t.
  foldr (\r a. addToPartition a eq (key r) r ) emptyDict t

--------------------------------------------------------------------------------
-- Maybe utils
--------------------------------------------------------------------------------

liftMaybePi : Pi z -> Pi (Maybe * z)
liftMaybePi = \r. syn #Maybe (\l. Just r.l)

nothingRecord : Pi (Maybe* z)
nothingRecord = syn #Maybe (const Nothing)

nothingRecordExample : Pi {'1 := Maybe Nat, '2 := Maybe String}
nothingRecordExample = prj (nothingRecord @{'1 := Nat, '2 := String})

nothingRecordExampleExpected = ('1 := Nothing, '2 := Nothing)

isJust : (Maybe a) -> Bool
isJust = ('Just: x -> True | 'Nothing: u -> False)

isJusts : Fold z => Pi (Maybe* z) -> Bool
isJusts = fold #Maybe (const isJust) and True

isNonEmpty : List a -> Bool
isNonEmpty = 'Cons: x -> True | 'Nil: u -> False

allNonEmpty : Fold cs => Pi (List* cs) -> Bool
allNonEmpty = fold #List (const isNonEmpty) and True

-- UNSAFE: Non-Terminating if a is Nothing
fromJust_DANGER_ : Maybe a -> a
fromJust_DANGER_ = fromMaybe (fix id)

unliftMaybePi : Fold z => Pi (Maybe* z) -> Maybe (Pi z)
unliftMaybePi = \r. if (isJusts r)
                 (Just (syn #Id (\k. fromJust_DANGER_ r.k)))
                 Nothing

            

--------------------------------------------------------------------------------
-- Record utils
--------------------------------------------------------------------------------

labelsP : Pi (Labels r)
labelsP = syn #(Const Unit) (const tt)

labelsS : Sigma r -> Sigma (Labels r)
labelsS = \r. ana #(\t. t) (\l v. inj (l := tt)) r

labelsL : List (Pi r) -> Pi (Labels r)
labelsL = const labelsP


-- PivotWider helpers
eqPrj : cs < r1, cs < r2 => Eq (Pi cs) -> Pi r1 -> Pi r2 -> Bool
eqPrj = \eqs r1 r2. eqs (prj r1) (prj r2)

--------------------------------------------------------------------------------
-- Non-empty List type
--------------------------------------------------------------------------------

type NonEmptyList : * -> *
-- should this have a sigma between tail is plain List and tail is NonEmptyList?
type NonEmptyList = \a. Sigma { 'Cons := Pair a (List a) }

-- type NonEmptyList : * -> *
-- type NonEmptyList = \a. Sigma {'Cons: \l. Pair a l}

baseList : List Nat
baseList = cons 1 nil

goodList : NonEmptyList Nat
goodList = ('Cons := pair 1 nil)

consNonEmpty : a -> List a -> NonEmptyList a
consNonEmpty = \hd tl. 'Cons: (pair hd tl)

nonEmptyList : a -> NonEmptyList a
nonEmptyList = \x. 'Cons: (pair x nil)

nonEmpty : List a -> Maybe (NonEmptyList a)
nonEmpty = ('Cons: x -> Just ('Cons: x) | 'Nil: u -> Nothing)

nonEmptyPi : Pi (List* cs) -> Pi (Maybe* (NonEmptyList* cs))
nonEmptyPi = \cs. syn #(\t. Maybe (NonEmptyList t)) (\l. nonEmpty cs.l)

headNonEmpty : NonEmptyList a -> a
headNonEmpty = 'Cons: x -> x.'1

--------------------------------------------------------------------------------
-- Table helpers
--------------------------------------------------------------------------------

-- helpers for flatten

-- helpers for flatten
getListColumns : (List* cs) < r => Pi (Labels cs) -> TableRow r -> TableRow (List* cs)
getListColumns = \cs r. prj r

columnsHead : Pi (NonEmptyList* cs) -> Pi cs
columnsHead = \r. syn #Id (\l. headNonEmpty r.l)

columnsTail : Pi (List* cs) -> Pi (List* cs)
columnsTail = \d. syn #List (\l. tail d.l)

consColumns : Pi cs -> Pi (List* cs) -> Pi (List* cs)
consColumns = \d ds. syn #List (\l. cons d.l ds.l)

transposeColumns : Fold cs => Pi (List* cs) -> List (Pi cs)
transposeColumns = fix (\transpose cs. ( 'Just: cns -> (cons (columnsHead cns)
                                                             (transpose (columnsTail cs)))
                                        |  'Nothing: u -> nil)
                                                         ((unliftMaybePi . nonEmptyPi) cs))


-- Speculative Functions

-- NOTE:
-- I was thinking about how to support untagged unions of labels, about which we only know
-- that they appear in a given row. It occurred to me that we could simulate this with
-- Sigma (Labels r), and still return a tagged union of values from r,
-- so we wouldn't need to introduce untagged unions of values.
-- Not sure if there is a use for this, but I think this should be a legal move.

-- select from r at an unknown label in r
selectField : Pi r -> Sigma (Labels r) -> Sigma r
selectField = \r ls. ana #(Const Unit) (\l v. l: r.l) ls

-- extract a bare T from a variant containing all Ts.
coerceVs : Sigma (((Const T)*) cs) -> T
coerceVs = \@T. \cs. ana #(Const T) (\l x. x) cs


-- There was somewhere I was able to use this, which could indicate
--  somewhere where inj isn't able to infer enough, but I don't have the example.
coerceLabel : {l := A} < r => #l -> Sigma (Labels r)
coerceLabel = \l. inj (l := tt)

-- Don't have a clean example for this, but it's possible to get the following errors:
  -- The predicate      {l := Unit} < (\y : *. Unit) cs
  -- is not entailed by {l := T} < (\y : *. T) cs

-- In this specific case it should be entailed.
-- maybe we could have some stronger inference rule here?

-- Labels is supposed to let us make statements like "The keys in A are a subset of the keys in B"


-- In general,  we should be able to say that:
--   1. (Const A)* r ~ ((Const A)* (Const B)* r)
--   2. If `{l := A} < r` then  `{l := B} <  (Const B)* r`
-- maybe we could have a stronger rule about `Const`


-- Identical to Eq a, just used for clarity
type Leq : * -> *
type Leq = \a. (a -> a -> Bool)

-- Comparer over existentially hidden key type, as required for orderBy
type Comparer : * -> *
type Comparer = \t. forall z. (forall v. (t -> v) -> Leq v -> z) -> z

mkComparer : (t -> v) -> Leq v -> Comparer t
mkComparer = \getKey compare f. f getKey compare

-- Produces a three-way comparison function (<=>) from a <= function
compFromLeq : Leq v -> Compare v
compFromLeq = \leq a b. if (leq a b)
                          (if (leq b a) EQ GT)
                          LT

-- combine 2 compare functions, with the 1st taking precedence
combineCompare : Compare v -> Compare v -> Compare v
combineCompare =
  \c1 c2 a b.
    match (c1 a b)
          ('EQ: u -> c2 a b
          | inj)

applyComparer : Comparer t -> Leq t
applyComparer = \c r1 r2. c (\getKey compare. compare (getKey r1) (getKey r2))

-- combine a list of Leq compares into a single Compare based on their order.
multiCompare : List (Comparer t) -> Compare t
multiCompare = (foldr combineCompare (const (const EQ))) . (map (compFromLeq . applyComparer))
