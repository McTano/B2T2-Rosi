dropColumnStudentsExpected = (::) ('name := "Bob", 'favorite_color := "blue")
           ((::) ('name := "Alice", 'favorite_color := "green")
           ((::) ('name := "Eve", 'favorite_color := "red")
                 nil))

dropColumnsStudents = dropColumns students ('age := tt, 'favorite_color := tt)

dropColumnsAltStudents : Table {'name := String}
dropColumnsAltStudents = dropColumnsAlt students

