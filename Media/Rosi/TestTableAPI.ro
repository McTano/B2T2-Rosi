selectStudents : Table {'id := Nat, 'name := String}
selectStudents = select students (\p. (prj p.'1) ++ ('id := p.'2))

selectStudentsExpected = cons ('id := 0, 'name := "Bob")
                              (cons ('id := 1, 'name := "Alice")
                              (cons ('id := 2, 'name := "Eve")
                                          nil))

countableTable : Table {'name:= String, 'favorite_number := Nat}
countableTable = cons ('name := "Bob", 'favorite_number := 9)
                                    (cons ('name := "Alice", 'favorite_number := 9)
                                    (cons ('name := "Eve", 'favorite_number := 9)
                                          (cons ('name := "Stew", 'favorite_number := 4)
                                                (cons ('name := "Other Alice", 'favorite_number := 4)
                                                      (cons ('name := "Terrible Steve", 'favorite_number := 1)
                                                            nil)))))

countFavoriteNumber = count countableTable 'favorite_number equal

