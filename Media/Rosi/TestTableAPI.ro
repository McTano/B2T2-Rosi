-- dropColumnsStudentsExpected : List (Sigma {'name := String})
dropColumnsStudentsExpected = cons ('name := "Bob")
                                    (cons ('name := "Alice")
                                    (cons ('name := "Eve")
                                          nil))

selectStudents : Table {'id := Nat, 'name := String}
selectStudents = select students (\p. (prj p.'1) ++ ('id := p.'2))

selectStudentsExpected = cons ('id := 0, 'name := "Bob")
                              (cons ('id := 1, 'name := "Alice")
                              (cons ('id := 2, 'name := "Eve")
                                          nil))

studentsWithDupeColors : StudentsTable
studentsWithDupeColors = (cons ('name := "Colton", 'age := 8, 'favorite_color := "red")
                                                     (cons ('name := "Terrible Steve", 'age := 2, 'favorite_color := "green")
                                                            students))

studentsFavoriteColorsAsDict = countHelper studentsWithDupeColors 'favorite_color (~)

getDictSuccess = getD studentsFavoriteColorsAsDict (~) "red"
getDictFailure = getD studentsFavoriteColorsAsDict (~) "pink"


studentsFavoriteColorsAsTable = count studentsWithDupeColors 'favorite_color (~)

studentsFavoriteColorsAsTableExpected : Table {'value := String, 'count := Nat}
studentsFavoriteColorsAsTableExpected = (cons ('value := "red", 'count := 2)
                                          (cons ('value := "green", 'count := 2)
                                                (cons ('value := "blue", 'count := 2)
                                                      nil)))

type ExampleRow : R[*]
type ExampleRow = {'Left := String, 'Right := String}

type VariantType : *
type VariantType = Sigma ExampleRow

concreteVariant : VariantType
concreteVariant = inj ('Left := "Bob")

concreteVariantInList : List VariantType
concreteVariantInList = cons concreteVariant nil

l'' : #'Example
l'' = 'Example

labeledWithVar : Sigma {'Example := String}
labeledWithVar = inj (l'' := "Basketball")

labeledWithVarViaCon : Sigma {'Example := String}
labeledWithVarViaCon = con l'' "Basketball"

labeledWithShorthand : Sigma {'Example := String}
labeledWithShorthand = 'Example: "Basketball"

labeledWithShorthandVar : Sigma {'Example := String}
labeledWithShorthandVar = l'': "Basketball"