import Ro.Base
import TableAPI, ExampleTables

-- built-ins
nrowsExample = nrows ((::) tt ((::) tt nil))

-- Constructors
type BracesRow : R[*]
type BracesRow = {'has_braces := Bool }

bracesTable : Table BracesRow
bracesTable = ((::) ('has_braces := True)
                    ((::) ('has_braces := False)
                           nil))

crossJoinExample : Table (StudentsRow + BracesRow)
crossJoinExample = crossJoin students bracesTable

type GradesRow : R[*]
type GradesRow = {'name := String, 'age := Nat, 'quiz1 := Nat, 'quiz2 := Nat, 'midterm := Nat}

grades : Table GradesRow
grades = (::) ('name := "Bob", 'age := 12, 'quiz1 := 8, 'quiz2 := 9, 'midterm := 77)
              ((::) ('name := "Alice", 'age := 17, 'quiz1 := 6, 'quiz2 := 8, 'midterm := 88)
                    ((::) ('name := "Eve", 'age := 13, 'quiz1 := 7, 'quiz2 := 9, 'midterm := 84)
                          nil))


leftJoinExample1 = leftJoin students grades (eqP ('name := (~), 'age := equal))

leftJoinExample1Expected = (::) ('name := "Bob", 'age := 12, 'favorite_color := "blue", 'quiz1 := Just 8, 'quiz2 := Just 9, 'midterm := Just 77)
                                ((::) ('name := "Alice", 'age := 17, 'favorite_color := "green", 'quiz1 := Just 6, 'quiz2 := Just 8, 'midterm := Just 88)
                                      ((::) ('name := "Eve", 'age := 13, 'favorite_color := "red", 'quiz1 := Just 7, 'quiz2 := Just 9, 'midterm := Just 84)
                                            nil))

leftJoinExample2 = leftJoin studentsWithDupeColors grades (eqP ('name := (~), 'age := equal))

leftJoinExample2Expected = ((::) ('name := "Colton", 'age := 8, 'favorite_color := "red", 'quiz1 := Nothing, 'quiz2 := Nothing, 'midterm := Nothing)
                                 ((::) ('name := "Terrible Steve", 'age := 2, 'favorite_color := "green", 'quiz1 := Nothing, 'quiz2 := Nothing, 'midterm := Nothing)
                                       ((::) ('name := "Bob", 'age := 12, 'favorite_color := "blue", 'quiz1 := Just 8, 'quiz2 := Just 9, 'midterm := Just 77)
                                             ((::) ('name := "Alice", 'age := 17, 'favorite_color := "green", 'quiz1 := Just 6, 'quiz2 := Just 8, 'midterm := Just 88)
                                                   ((::) ('name := "Eve", 'age := 13, 'favorite_color := "red", 'quiz1 := Just 7, 'quiz2 := Just 9, 'midterm := Just 84)
                                                    nil)))))

-- leftJoinExample3 : StudentsTable
-- This has an unsatisfiable constraint since the input tables should have disjoint schemas except for 'favorite_color.
-- It doesn't produce an error, but doesn't fully resolve to a value.
-- with a type annotation, it does produce an error.
leftJoinExample3 = leftJoin students studentsWithDupeColors (eqP ('favorite_color := (~)))

-- we can omit the type annotation for this version
-- selectColumnsStudents : Table {'name := String, 'favorite_color := String}
selectColumnsStudents = selectColumns students ('favorite_color := tt, 'name := tt)

-- need type annotation to determine behavior
-- value with inferred type would be
-- \p TableAPI.selectColumnsAlt [{'age := Mu (\n : *. Sigma {'Succ := n, 'Zero := Pi {}}), 'favorite_color := String, 'name := String}] [a#44] [VVar 0] (ExampleTables.students)
selectColumnsAltStudents : Table {'name := String, 'favorite_color := String}
selectColumnsAltStudents = selectColumnsAlt students


selectColumnsStudentsExpected : Table {'name := String, 'favorite_color := String}
selectColumnsStudentsExpected = (::) ('name := "Bob", 'favorite_color := "blue")
           ((::) ('name := "Alice", 'favorite_color := "green")
           ((::) ('name := "Eve", 'favorite_color := "red")
                 nil))

